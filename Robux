--========================================================================
-- Number formatting helpers
--========================================================================
-- strip everything but digits, cap at 12 digits, then add commas
local function sanitizeAndFormat(raw)
	local digits = (raw or ""):gsub("%D", "")
	if #digits > 12 then
		digits = digits:sub(1, 12)
	end
	if digits == "" then
		return "", "0"  -- box text, target text
	end
	-- insert commas every 3 from the right
	local formatted = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	formatted = formatted:gsub("^,", "")
	return formatted, formatted
end

