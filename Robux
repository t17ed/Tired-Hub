--========================================================================
-- Number formatting (digits only, auto-comma, 12 digit cap)
--========================================================================
local function sanitizeAndFormat(raw)
	local digits = (raw or ""):gsub("%D", "")
	if #digits > 12 then
		digits = digits:sub(1, 12)
	end
	if digits == "" then
		return "", "0"
	end
	local formatted = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return formatted, formatted
end

local updating = false
box:GetPropertyChangedSignal("Text"):Connect(function()
	if updating then return end
	updating = true

	local formattedBox, targetVal = sanitizeAndFormat(box.Text)
	if box.Text ~= formattedBox then
		box.Text = formattedBox
	end

	rebuildTarget(targetVal)
	refreshAll()
	safeWrite(targetVal)

	updating = false
end)

