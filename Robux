--========================================================================
-- BuyButton fake-confirm sequence + slide-out
--========================================================================
local function findSheetContainer()
	local safe = foundationOverlay:FindFirstChild("SafeAreaFrame")
	if not safe then return nil end
	local portal = safe:FindFirstChild("OverlayPortal")
	if not portal then return nil end
	return portal:FindFirstChild("SheetContainer")
end

local buyHooked = {}

local function hookBuyButton(buyBtn)
	if buyHooked[buyBtn] then return end
	buyHooked[buyBtn] = true
	print("[RobuxEditor] BuyButton hooked.")

	local function runSequence()
		-- locate the sliding sheet to tween out afterwards
		local sheetContainer = findSheetContainer()

		buyBtn.Text = "Processing..."
		task.wait(2)
		buyBtn.Text = "Confirmed! [3]"
		task.wait(1)
		buyBtn.Text = "Confirmed! [2]"
		task.wait(1)
		buyBtn.Text = "Confirmed! [1]"
		task.wait(1)

		-- quick smooth slide down + fade out
		if sheetContainer then
			local target = sheetContainer:FindFirstChild("Frame") or sheetContainer
			local startPos = target.Position
			local outInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			TweenService:Create(target, outInfo, {
				Position = startPos + UDim2.new(0, 0, 1.2, 0),
			}):Play()
		end
	end

	-- TextButton -> Activated; otherwise watch for a clickable parent
	if buyBtn:IsA("GuiButton") then
		buyBtn.Activated:Connect(runSequence)
	else
		-- BuyButton is a frame/label: attach to a child button if present
		local childBtn = buyBtn:FindFirstChildWhichIsA("GuiButton", true)
		if childBtn then
			childBtn.Activated:Connect(runSequence)
		end
	end
end

-- watch for the BuyButton appearing
task.spawn(function()
	while task.wait(0.5) do
		local sheetContainer = findSheetContainer()
		if sheetContainer then
			local buyBtn
			local ok = pcall(function()
				buyBtn = sheetContainer.Frame.Sheet.Content.Actions["1"].BuyButton
			end)
			if ok and buyBtn then
				hookBuyButton(buyBtn)
			end
		end
	end
end)

