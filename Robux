local function dprint(...)
	if DEBUG then
		print("[RobuxEditor][DEBUG]", ...)
	end
end

local function warnf(...)
	warn("[RobuxEditor]", ...)
end

print("[RobuxEditor] v3 starting. DEBUG =", DEBUG)

--========================================================================
-- Persistence
--========================================================================
local SAVE_FILE = "RobuxEditor_amount.txt"

local function safeRead()
	local ok, data = pcall(function()
		if isfile and isfile(SAVE_FILE) then
			return readfile(SAVE_FILE)
		end
	end)
	if ok and data and #data > 0 then
		dprint("Loaded saved amount:", data)
		return data
	end
	dprint("No saved amount found (or no file API). Defaulting to 0.")
	return "0"
end

local function safeWrite(value)
	local ok = pcall(function()
		if writefile then
			writefile(SAVE_FILE, value)
		end
	end)
	dprint("Saved amount:", value, "| write ok:", ok)
end

