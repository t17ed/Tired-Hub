--========================================================================
-- Persistence (executor file API, safely guarded)
--========================================================================
local SAVE_FILE = "RobuxEditor_amount.txt"

local function safeRead()
	local ok, data = pcall(function()
		if isfile and isfile(SAVE_FILE) then
			return readfile(SAVE_FILE)
		end
	end)
	if ok and data and #data > 0 then
		return data
	end
	return "0"
end

local function safeWrite(value)
	pcall(function()
		if writefile then
			writefile(SAVE_FILE, value)
		end
	end)
end

--========================================================================
-- TARGET_TEXT (rebuilt whenever the amount changes)
--========================================================================
local ROBUX_TAG =
	'<font family="rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json" weight="400">robux</font>'

-- amount is stored as the formatted (comma'd) string the user typed
local currentAmount = safeRead()
local TARGET_TEXT = ROBUX_TAG .. " " .. currentAmount

local function rebuildTarget(formatted)
	currentAmount = formatted
	TARGET_TEXT = ROBUX_TAG .. " " .. formatted
end

--========================================================================
-- Robux price forcing
--========================================================================
local hooked = {}

local function forceObject(obj)
	if not obj then return end
	if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end

	obj.RichText = true
	obj.Text = TARGET_TEXT

	if hooked[obj] then return end
	hooked[obj] = true
	print("[RobuxEditor] Hooked:", obj:GetFullName())

	obj:GetPropertyChangedSignal("Text"):Connect(function()
		if obj.Text ~= TARGET_TEXT and obj.Visible then
			obj.Text = TARGET_TEXT
		end
	end)

	obj:GetPropertyChangedSignal("Visible"):Connect(function()
		if obj.Visible then
			obj.Text = TARGET_TEXT
		end
	end)

	task.spawn(function()
		while obj and obj.Parent do
			if obj.Visible then
				if obj.Text ~= TARGET_TEXT then
					obj.Text = TARGET_TEXT
				end
				if not obj.RichText then
					obj.RichText = true
				end
			end
			task.wait()
		end
		hooked[obj] = nil
	end)
end

-- push a freshly-built TARGET_TEXT to every hooked object
local function refreshAll()
	for obj in pairs(hooked) do
		if obj and obj.Parent and obj.Visible then
			obj.Text = TARGET_TEXT
		end
	end
end

