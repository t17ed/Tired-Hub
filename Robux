--========================================================================
-- Robux label forcing
--========================================================================
local hooked = {}
local hookedCount = 0
local buyState = "searching"

local function updateStatus()
	status.Text = ("hooked: %d | buy button: %s"):format(hookedCount, buyState)
end

local NAME_MATCHES = {
	RobuxPrice = true, RobuxText = true, RobuxNumberLabel = true,
	RobuxAmount = true, RobuxBalance = true,
}

-- STRICT matcher (v4): a label only qualifies if it actually LOOKS like a
-- robux amount display: a robux icon (BuilderIcons tag or glyph) followed
-- by ONLY a number (digits/commas/periods/K/M/B/+ suffix). This stops the
-- v3 bug where unrelated labels (anything containing the icon glyph or
-- "robux" in its name) got rewritten too.
local GLYPH_E002 = utf8.char(0xE002)
local GLYPH_E001 = utf8.char(0xE001)

-- after removing the icon, the remainder must be a plain amount
local function isAmountOnly(rest)
	rest = rest:gsub("^%s+", ""):gsub("%s+$", "")
	if rest == "" then return false end
	-- digits with optional commas/periods and optional K/M/B+ suffix
	return rest:match("^[%d,%.]+[KMBkmb]?%+?$") ~= nil
end

local function isRobuxLabel(obj)
	if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
		return false
	end
	if obj:IsDescendantOf(gui) then
		return false
	end
	local t = obj.Text or ""

	-- exact-name whitelist still applies regardless of current text
	if NAME_MATCHES[obj.Name] then
		return true, "name:" .. obj.Name
	end

	-- BuilderIcons rich-text robux tag + amount-only remainder
	if t:find("BuilderIcons", 1, true) and t:find(">robux<", 1, true) then
		local rest = t:gsub("<font[^>]*>robux</font>", "")
		if isAmountOnly(rest) then
			return true, "builder-icons-tag+amount"
		end
		return false
	end

	-- icon glyph + amount-only remainder
	if t:find(GLYPH_E002, 1, true) then
		local rest = t:gsub(GLYPH_E002, "")
		if isAmountOnly(rest) then
			return true, "glyph-E002+amount"
		end
		return false
	end
	if t:find(GLYPH_E001, 1, true) then
		local rest = t:gsub(GLYPH_E001, "")
		if isAmountOnly(rest) then
			return true, "glyph-E001+amount"
		end
		return false
	end

	return false
end

local function forceObject(obj, reason)
	if hooked[obj] then return end
	hooked[obj] = true
	hookedCount += 1
	updateStatus()
	print(("[RobuxEditor] Hooked (%s): %s | original text: %q")
		:format(reason or "?", obj:GetFullName(), tostring(obj.Text)))

	pcall(function()
		obj.RichText = true
		obj.Text = TARGET_TEXT
	end)

	obj:GetPropertyChangedSignal("Text"):Connect(function()
		if obj.Text ~= TARGET_TEXT and obj.Visible then
			dprint("Re-forcing (text changed externally):", obj:GetFullName())
			obj.Text = TARGET_TEXT
		end
	end)

	obj:GetPropertyChangedSignal("Visible"):Connect(function()
		if obj.Visible then
			obj.Text = TARGET_TEXT
		end
	end)

	task.spawn(function()
		while obj and obj.Parent do
			if obj.Visible then
				if obj.Text ~= TARGET_TEXT then
					obj.Text = TARGET_TEXT
				end
				if not obj.RichText then
					obj.RichText = true
				end
			end
			task.wait()
		end
		hooked[obj] = nil
		hookedCount -= 1
		updateStatus()
		dprint("Unhooked (destroyed):", tostring(obj))
	end)
end

local function refreshAll()
	for obj in pairs(hooked) do
		if obj and obj.Parent and obj.Visible then
			obj.Text = TARGET_TEXT
		end
	end
end

local function tryHook(obj)
	local ok, match, reason = pcall(isRobuxLabel, obj)
	if ok and match then
		forceObject(obj, reason)
	end
end

