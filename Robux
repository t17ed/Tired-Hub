--========================================================================
-- BuyButton sequence
--
-- KEY FIX: in the prompt, "BuyButton > Text" means the visible text is a
-- CHILD INSTANCE named "Text" under BuyButton — NOT BuyButton.Text.
-- We find the real TextLabel and LOCK it during the sequence, because
-- Roblox's UI framework keeps rewriting it.
--========================================================================
local buyHooked = {}

local function getBuyTextLabel(buyBtn)
	-- exact child named "Text" first
	local t = buyBtn:FindFirstChild("Text")
	if t and (t:IsA("TextLabel") or t:IsA("TextButton")) then
		return t
	end
	-- any descendant named "Text"
	for _, d in ipairs(buyBtn:GetDescendants()) do
		if d.Name == "Text" and (d:IsA("TextLabel") or d:IsA("TextButton")) then
			return d
		end
	end
	-- fall back to first text-bearing descendant
	for _, d in ipairs(buyBtn:GetDescendants()) do
		if d:IsA("TextLabel") then
			return d
		end
	end
	-- last resort: the button itself if it's text-capable
	if buyBtn:IsA("TextButton") then
		return buyBtn
	end
	return nil
end

local sequenceRunning = false

--------------------------------------------------------------------------
-- Fade out the ENTIRE FoundationOverlay, then make it invisible.
-- Tweens every transparency property of every descendant, hides the
-- overlay, restores the original values (so it isn't permanently broken),
-- and re-enables it automatically next time Roblox opens a new sheet.
--------------------------------------------------------------------------
local function fadeOutOverlay(overlay, duration)
	duration = duration or 0.35
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local originals = {} -- { {instance, prop, value}, ... }

	local function fadeProp(inst, prop)
		local ok, val = pcall(function() return inst[prop] end)
		if ok and typeof(val) == "number" and val < 1 then
			table.insert(originals, { inst, prop, val })
			pcall(function()
				TweenService:Create(inst, info, { [prop] = 1 }):Play()
			end)
		end
	end

	local faded = 0
	for _, d in ipairs(overlay:GetDescendants()) do
		if d:IsA("GuiObject") then
			fadeProp(d, "BackgroundTransparency")
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				fadeProp(d, "TextTransparency")
				fadeProp(d, "TextStrokeTransparency")
			end
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then
				fadeProp(d, "ImageTransparency")
			end
			if d:IsA("ScrollingFrame") then
				fadeProp(d, "ScrollBarImageTransparency")
			end
			faded += 1
		elseif d:IsA("UIStroke") then
			fadeProp(d, "Transparency")
		end
	end
	dprint(("Fading out FoundationOverlay: %d gui objects, %d tweened props")
		:format(faded, #originals))

	task.wait(duration + 0.05)

	-- now make the whole overlay invisible
	if overlay:IsA("ScreenGui") then
		overlay.Enabled = false
	else
		pcall(function() overlay.Visible = false end)
	end
	dprint("FoundationOverlay hidden.")

	-- restore original transparencies while hidden, so the overlay
	-- renders normally when it comes back
	for _, entry in ipairs(originals) do
		local inst, prop, val = entry[1], entry[2], entry[3]
		if inst and inst.Parent ~= nil then
			pcall(function() inst[prop] = val end)
		end
	end

	-- re-enable automatically when Roblox opens the next prompt
	local conn
	conn = overlay.DescendantAdded:Connect(function()
		conn:Disconnect()
		task.wait(0.1)
		if overlay:IsA("ScreenGui") then
			overlay.Enabled = true
		else
			pcall(function() overlay.Visible = true end)
		end
		dprint("FoundationOverlay re-enabled (new prompt detected).")
	end)
end

local function runSequence(buyBtn, sheetContainer)
	if sequenceRunning then
		dprint("Sequence already running, ignoring click.")
		return
	end
	sequenceRunning = true

	local label = getBuyTextLabel(buyBtn)
	if not label then
		warnf("Could not find a text label inside BuyButton! Dumping its children:")
		for _, d in ipairs(buyBtn:GetDescendants()) do
			print("   ", d.ClassName, d:GetFullName())
		end
		sequenceRunning = false
		return
	end
	dprint("Sequence label:", label:GetFullName())

	-- lock the label to our value while the sequence runs
	local lockedText = nil
	local lockConn = label:GetPropertyChangedSignal("Text"):Connect(function()
		if lockedText and label.Text ~= lockedText then
			label.Text = lockedText
		end
	end)
	local function setLocked(txt)
		lockedText = txt
		label.Text = txt
		dprint("BuyButton text ->", txt)
	end

	setLocked("Processing...")
	task.wait(2)
	setLocked("Confirmed! [3]")
	task.wait(1)
	setLocked("Confirmed! [2]")
	task.wait(1)
	setLocked("Confirmed! [1]")
	task.wait(1)

	lockConn:Disconnect()

	-- quick smooth slide-out of the sheet WHILE the whole overlay fades,
	-- then the overlay is made invisible
	local overlay = CoreGui:FindFirstChild("FoundationOverlay")
	if sheetContainer and sheetContainer.Parent then
		local target = sheetContainer:FindFirstChild("Frame") or sheetContainer
		dprint("Tweening out:", target:GetFullName())
		local outInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(target, outInfo, {
			Position = target.Position + UDim2.new(0, 0, 1.2, 0),
		}):Play()
	end
	if overlay then
		fadeOutOverlay(overlay, 0.35) -- waits for the fade, then hides it
	else
		dprint("FoundationOverlay not found at fade time.")
	end

	sequenceRunning = false
end

local function hookBuyButton(buyBtn, sheetContainer)
	if buyHooked[buyBtn] then return end
	buyHooked[buyBtn] = true
	buyState = "HOOKED"
	updateStatus()
	print("[RobuxEditor] BuyButton hooked:", buyBtn:GetFullName())

	local function onClick()
		dprint("BuyButton clicked!")
		task.spawn(runSequence, buyBtn, sheetContainer)
	end

	-- connect to every clickable thing in/around the button
	local connectedAny = false
	if buyBtn:IsA("GuiButton") then
		buyBtn.Activated:Connect(onClick)
		connectedAny = true
		dprint("Connected to BuyButton.Activated directly")
	end
	for _, d in ipairs(buyBtn:GetDescendants()) do
		if d:IsA("GuiButton") then
			d.Activated:Connect(onClick)
			connectedAny = true
			dprint("Connected to child button:", d:GetFullName())
		end
	end
	if not connectedAny then
		-- not a button at all: fall back to raw input on the frame
		buyBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				onClick()
			end
		end)
		dprint("No GuiButton found — connected via InputBegan fallback")
	end

	buyBtn.AncestryChanged:Connect(function(_, parent)
		if not parent then
			buyHooked[buyBtn] = nil
			buyState = "searching"
			updateStatus()
			dprint("BuyButton destroyed, back to searching.")
		end
	end)
end

-- Background watcher — never blocks GUI creation
task.spawn(function()
	local foundationOverlay = CoreGui:WaitForChild("FoundationOverlay", math.huge)
	print("[RobuxEditor] FoundationOverlay appeared.")

	local function findSheetContainer()
		local safe = foundationOverlay:FindFirstChild("SafeAreaFrame")
		if not safe then return nil end
		local portal = safe:FindFirstChild("OverlayPortal")
		if not portal then return nil end
		return portal:FindFirstChild("SheetContainer")
	end

	while task.wait(0.25) do
		local sheetContainer = findSheetContainer()
		if sheetContainer then
			-- exact documented path first
			local buyBtn
			pcall(function()
				buyBtn = sheetContainer.Frame.Sheet.Content.Actions["1"].BuyButton
			end)
			-- fallback: any descendant literally named "BuyButton"
			if not buyBtn then
				buyBtn = sheetContainer:FindFirstChild("BuyButton", true)
				if buyBtn then
					dprint("BuyButton found via recursive search (exact path failed)")
				end
			end
			if buyBtn then
				hookBuyButton(buyBtn, sheetContainer)
			elseif buyState ~= "HOOKED" then
				buyState = "sheet open, no BuyButton yet"
				updateStatus()
			end
		end
	end
end)

updateStatus()
