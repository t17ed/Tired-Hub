local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")
local player = Players.LocalPlayer

local NEW_SOUND = "rbxassetid://124683653567361"

local function findHighlightedModel()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Highlight") then
			local model = obj.Adornee or obj.Parent
			if model and model:IsA("Model") then
				return model
			end
		end
	end
	return nil
end

local function incrementCounter()
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end
	local topFrame = playerGui:FindFirstChild("DuelsMachineTopFrame")
	if not topFrame then
		return
	end
	local inner = topFrame:FindFirstChild("DuelsMachineTopFrame")
	if not inner then
		return
	end
	local red = inner:FindFirstChild("Red")
	if not red then
		return
	end
	local label = red:FindFirstChild("Label")
	if not label then
		return
	end
	local current = (tonumber(label.Text) or 0) + 1
	label.Text = tostring(current)
	if current >= 3 then
		task.delay(0.5, function()
			player:Kick("Completed!")
		end)
	end
end

local function showNotification(message)
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end
	local gui = playerGui:FindFirstChild("Notification")
	if not gui then
		return
	end
	local container = gui:FindFirstChild("Notification")
	if not container then
		return
	end
	local template = container:FindFirstChild("Template")
	if not template then
		return
	end
	local clone = template:Clone()
	local label
	if clone:IsA("TextLabel") then
		label = clone
	else
		label = clone:FindFirstChildWhichIsA("TextLabel", true)
	end
	if label then
		label.RichText = true
		label.Text = message
	end
	if clone:IsA("GuiObject") then
		clone.Visible = true
	end
	clone.Parent = container
	incrementCounter()
	task.delay(10, function()
		clone:Destroy()
	end)
end

local function playSound(soundId)
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = 1
	sound.Parent = SoundService
	ContentProvider:PreloadAsync({ sound })
	sound:Play()
	task.wait(sound.TimeLength)
	sound:Destroy()
end

local function playAnimalSound(name)
	local sounds = ReplicatedStorage:FindFirstChild("Sounds")
	if not sounds then
		return
	end
	local animals = sounds:FindFirstChild("Animals")
	if not animals then
		return
	end
	local animalSound = animals:FindFirstChild(name)
	if not animalSound then
		return
	end
	local sound = animalSound:Clone()
	sound.Parent = SoundService
	ContentProvider:PreloadAsync({ sound })
	sound:Play()
	task.wait(sound.TimeLength)
	sound:Destroy()
end

local model = findHighlightedModel()
if model then
	local name = model.Name
	for i = 1, 3 do
		playAnimalSound(name)
		if i == 3 then
			showNotification('<font color="#ff0004">@' .. player.Name .. '</font> won the duel!')
		else
			showNotification('<font color="#ff0004">@' .. player.Name .. '</font> won this round!')
		end
		playSound(NEW_SOUND)
	end
end
