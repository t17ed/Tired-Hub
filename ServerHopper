--[[
	BeamSpiralWin - LocalScript
	Place in: StarterPlayer > StarterPlayerScripts (or StarterGui)

	Flow per button press:
	1. Beam from player -> (-473, -7, 114)
	2. Tween to (-476, -7, 27) at ~100 walkspeed
	3. Tween to (-483, -5, 25) at ~100 walkspeed
	4. Spiral around (-473, -7, 114), no collision, lands exactly on it (< 2s)
	5. Clone PlayerGui.Notification.Notification.Template -> rich text win message

	Requires: PlayerGui > Notification (ScreenGui) > Notification (Frame) > Template (TextLabel)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Config ---------------------------------------------------------------
local BEAM_TARGET   = Vector3.new(-473, -7, 114)
local TWEEN_POINT_1 = Vector3.new(-476, -7, 27)
local TWEEN_POINT_2 = Vector3.new(-483, -5, 25)
local SPIRAL_CENTER = Vector3.new(-473, -7, 114)
local SPEED         = 100      -- studs/sec ("walkspeed")
local SPIRAL_TIME   = 1.8      -- seconds (< 2)
local SPIRAL_TURNS  = 3        -- full rotations during the spiral
-------------------------------------------------------------------------

local busy = false
local runSequence -- forward declaration

-- =======================================================================
-- Draggable button
-- =======================================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BeamSpiralGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Name = "ActivateButton"
button.Size = UDim2.fromOffset(140, 44)
button.Position = UDim2.new(0.5, -70, 0.85, 0)
button.BackgroundColor3 = Color3.fromRGB(255, 0, 4)
button.TextColor3 = Color3.new(1, 1, 1)
button.Font = Enum.Font.GothamBold
button.TextSize = 18
button.Text = "ACTIVATE"
button.AutoButtonColor = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = button

-- Custom drag (works on PC + mobile; Frame.Draggable is deprecated)
do
	local dragging = false
	local dragStart, startPos
	local moved = false

	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = button.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 4 then moved = true end
			button.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Only fire when it was a click, not a drag
	button.Activated:Connect(function()
		if not moved then
			runSequence()
		end
	end)
end

-- =======================================================================
-- Helpers
-- =======================================================================
local function setCollision(character, canCollide)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = canCollide
		end
	end
end

local function tweenTo(hrp, targetPos)
	local distance = (hrp.Position - targetPos).Magnitude
	local duration = distance / SPEED
	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ CFrame = CFrame.new(targetPos, Vector3.new(SPIRAL_CENTER.X, targetPos.Y, SPIRAL_CENTER.Z)) }
	)
	tween:Play()
	tween.Completed:Wait()
end

local function showNotification()
	local pg = player:WaitForChild("PlayerGui")
	local notifGui = pg:FindFirstChild("Notification")
	local notifFrame = notifGui and notifGui:FindFirstChild("Notification")
	local template = notifFrame and notifFrame:FindFirstChild("Template")
	if not template then
		warn("[BeamSpiralWin] PlayerGui.Notification.Notification.Template not found")
		return
	end

	local clone = template:Clone()
	clone.Name = "WinNotification"
	clone.RichText = true
	clone.Text = '<font color="#ff0004">@' .. player.Name .. '</font> won this round!'
	clone.Visible = true
	clone.Parent = template.Parent

	task.delay(5, function()
		if clone then clone:Destroy() end
	end)
end

-- =======================================================================
-- Main sequence
-- =======================================================================
function runSequence() -- assigns the forward-declared local
	if busy then return end
	busy = true

	local ok, err = pcall(function()
		local character = player.Character or player.CharacterAdded:Wait()
		local hrp = character:WaitForChild("HumanoidRootPart")
		local humanoid = character:WaitForChild("Humanoid")

		-- 1) Beam from player to BEAM_TARGET --------------------------------
		local targetPart = Instance.new("Part")
		targetPart.Anchored = true
		targetPart.CanCollide = false
		targetPart.Transparency = 1
		targetPart.Size = Vector3.new(0.2, 0.2, 0.2)
		targetPart.Position = BEAM_TARGET
		targetPart.Parent = workspace

		local a0 = Instance.new("Attachment", hrp)
		local a1 = Instance.new("Attachment", targetPart)

		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 4))
		beam.Width0, beam.Width1 = 0.5, 0.5
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Parent = hrp

		-- 2) + 3) Tweens at ~100 walkspeed, no physics interference ---------
		humanoid.PlatformStand = true
		setCollision(character, false)
		hrp.Anchored = true

		tweenTo(hrp, TWEEN_POINT_1)
		tweenTo(hrp, TWEEN_POINT_2)

		-- 4) Spiral around SPIRAL_CENTER, end exactly on it (< 2s) ----------
		local startOffset = hrp.Position - SPIRAL_CENTER
		local startRadius = Vector3.new(startOffset.X, 0, startOffset.Z).Magnitude
		local startAngle = math.atan2(startOffset.Z, startOffset.X)
		local startY = hrp.Position.Y

		local elapsed = 0
		while elapsed < SPIRAL_TIME do
			elapsed += RunService.Heartbeat:Wait()
			local alpha = math.min(elapsed / SPIRAL_TIME, 1)
			local eased = 1 - (1 - alpha) ^ 2                     -- ease-out
			local radius = startRadius * (1 - eased)              -- shrink to 0
			local angle = startAngle + eased * SPIRAL_TURNS * math.pi * 2
			local pos = Vector3.new(
				SPIRAL_CENTER.X + math.cos(angle) * radius,
				startY + (SPIRAL_CENTER.Y - startY) * eased,
				SPIRAL_CENTER.Z + math.sin(angle) * radius
			)
			hrp.CFrame = CFrame.new(pos)
				* CFrame.Angles(0, angle + math.pi / 2, 0)        -- face along the spin
		end

		hrp.CFrame = CFrame.new(SPIRAL_CENTER)                    -- exact landing

		-- Restore character -------------------------------------------------
		hrp.Anchored = false
		setCollision(character, true)
		humanoid.PlatformStand = false

		-- Cleanup beam -------------------------------------------------------
		beam:Destroy()
		a0:Destroy()
		targetPart:Destroy()

		-- 5) Notification ------------------------------------------------------
		showNotification()
	end)

	if not ok then
		warn("[BeamSpiralWin] " .. tostring(err))
	end
	busy = false
end
