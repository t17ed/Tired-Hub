local function spawnAnimal(name, pivotCFrame)
	local models = ReplicatedStorage:FindFirstChild("Models")
	local animals = models and models:FindFirstChild("Animals")
	if not animals then return nil end
	local src = animals:FindFirstChild(name)
	if not src then return nil end
	local clone = src:Clone()
	if clone:IsA("Model") then
		if not clone.PrimaryPart then
			clone.PrimaryPart = clone:FindFirstChildWhichIsA("BasePart")
		end
		pcall(function() clone:PivotTo(pivotCFrame) end)
	elseif clone:IsA("BasePart") then
		clone.CFrame = pivotCFrame
	end
	clone.Parent = Workspace
	return clone
end

local function attachAnimalOverhead(model)
	local overheads = ReplicatedStorage:FindFirstChild("Overheads")
	local example = overheads and overheads:FindFirstChild("AnimalOverheadExample")
	if not example then return end
	local gui = example:Clone()
	local info = gui:FindFirstChild("Info")
	local animalOverhead = info and info:FindFirstChild("AnimalOverhead")
	local stolen = animalOverhead and animalOverhead:FindFirstChild("Stolen")
	if stolen and (stolen:IsA("TextLabel") or stolen:IsA("TextButton")) then
		stolen.Text = "STOLEN"
		stolen.Visible = true
	end
	local part = model:FindFirstChild("Head")
		or (model:IsA("Model") and model.PrimaryPart)
		or model:FindFirstChildWhichIsA("BasePart")
	if gui:IsA("BillboardGui") then
		gui.Adornee = part
	end
	gui.Parent = part or model
end

local function makeCube(cframe)
	local cube = Instance.new("Part")
	cube.Name = "ClaudeTestCube"
	cube.Size = Vector3.new(4, 4, 4)
	cube.Material = Enum.Material.Neon
	cube.Color = Color3.fromRGB(150, 0, 255)
	cube.Anchored = true
	cube.CanCollide = false
	cube.CFrame = cframe
	cube.Parent = Workspace
	return cube
end

local function showNotification(text)
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then return end
	local n1 = pg:FindFirstChild("Notification")
	local n2 = n1 and n1:FindFirstChild("Notification")
	local template = n2 and n2:FindFirstChild("Template")
	if not template then return end
	local clone = template:Clone()
	clone.Visible = true
	if clone:IsA("TextLabel") or clone:IsA("TextButton") then
		clone.Text = text
	else
		local lbl = clone:FindFirstChildWhichIsA("TextLabel", true)
		if lbl then lbl.Text = text end
	end
	clone.Parent = n2
	return clone
end

local function raiseAndFreezeCamera()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = cam.CFrame + Vector3.new(0, 10, 0)
end

local function flingCube(cube, endPos, duration)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not cube or not cube.Parent or (os.clock() - t0) >= duration then
			if conn then conn:Disconnect() end
			return
		end
		local jitter = Vector3.new(
			(rng:NextNumber() - 0.5) * 4,
			(rng:NextNumber() - 0.5) * 4,
			(rng:NextNumber() - 0.5) * 4
		)
		cube.CFrame = CFrame.new(endPos + jitter) * CFrame.Angles(
			rng:NextNumber() * math.pi * 2,
			rng:NextNumber() * math.pi * 2,
			rng:NextNumber() * math.pi * 2
		)
	end)
	task.wait(duration)
	if conn then conn:Disconnect() end
end

local function runSequence()
	if running then return end
	running = true

	local char = player.Character
	local root = getRoot()
	if not char or not root then
		running = false
		return
	end
	local head = char:FindFirstChild("Head") or root

	raiseAndFreezeCamera()
	makeHeadGui(head)

	local animalName = ANIMAL_NAMES[rng:NextInteger(1, #ANIMAL_NAMES)]

	task.wait(rng:NextNumber(2, 3))
	setCharacterVisible(false)

	local delivery = FindDelivery()
	local deliveryCF = getDeliveryCFrame(delivery)
	local endPos = deliveryCF and deliveryCF.Position or root.Position
	local animalPos = deliveryCF and (deliveryCF * CFrame.new(0, 0, -10)).Position
		or (endPos - Vector3.new(0, 0, 10))

	local animalModel = spawnAnimal(animalName, CFrame.new(animalPos))
	if animalModel then
		attachAnimalOverhead(animalModel)
	end

	local cube = makeCube(CFrame.new(endPos))
	flingCube(cube, endPos, 3)

	showNotification("You Stole " .. animalName)

	if animalModel then animalModel:Destroy() end
	if cube then cube:Destroy() end

	task.wait(0.02)
	player:Kick("You Stole " .. animalName)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.Q then
		task.spawn(runSequence)
	end
end)

task.spawn(function()
	while true do
		updateBaseBeam()
		task.wait(2)
	end
end)

player.CharacterAdded:Connect(function(char)
	char:WaitForChild("HumanoidRootPart", 10)
	task.wait(1)
	updateBaseBeam()
end)

