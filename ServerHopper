local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local rng = Random.new()

local ANIMAL_NAMES = {
	"Lavadorito Spinito", "Garama and Madundung", "Jolly Jolly Sahur", "Dragon Canneloni",
	"Ventoliero Pavonero", "Burguro And Fryuro", "Capitano Moby", "Hydra Dragon Cannelloni",
}

local beamBase, attPlayerBase, attBase
local running = false

local function FindDelivery()
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, plot in pairs(plots:GetChildren()) do
		local sign = plot:FindFirstChild("PlotSign")
		if sign then
			local yourBase = sign:FindFirstChild("YourBase")
			if yourBase and yourBase.Enabled then
				local hitbox = plot:FindFirstChild("DeliveryHitbox")
				if hitbox then return hitbox end
			end
		end
	end
	return nil
end

local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function getDeliveryCFrame(delivery)
	if not delivery then return nil end
	if delivery:IsA("BasePart") then
		return delivery.CFrame
	elseif delivery:IsA("Model") then
		return delivery:GetPivot()
	end
	return nil
end

local function updateBaseBeam()
	local delivery = FindDelivery()
	local root = getRoot()
	if not delivery or not root then return end

	if not attPlayerBase or attPlayerBase.Parent ~= root then
		if attPlayerBase then attPlayerBase:Destroy() end
		attPlayerBase = Instance.new("Attachment")
		attPlayerBase.Name = "BeamAttachment_PlayerBase"
		attPlayerBase.Parent = root
	end

	if not attBase or attBase.Parent ~= delivery then
		if attBase then attBase:Destroy() end
		attBase = Instance.new("Attachment")
		attBase.Name = "BeamAttachment_Base"
		attBase.Parent = delivery
	end

	if not beamBase or not beamBase.Parent then
		beamBase = Instance.new("Beam")
		beamBase.Name = "BeamToBase"
		beamBase.Attachment0 = attPlayerBase
		beamBase.Attachment1 = attBase
		beamBase.Color = ColorSequence.new(Color3.fromRGB(0, 255, 0))
		beamBase.Width0 = 0.9
		beamBase.Width1 = 0.9
		beamBase.LightEmission = 1
		beamBase.Transparency = NumberSequence.new(0)
		beamBase.FaceCamera = true
		beamBase.Parent = Workspace
	else
		beamBase.Attachment0 = attPlayerBase
		beamBase.Attachment1 = attBase
	end
end

local function setCharacterVisible(visible)
	local char = player.Character
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = visible and 0 or 1
		end
	end
end

