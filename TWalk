local function makeSwitch(parent, default, onChange)
    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 46, 0, 22)
    track.BackgroundColor3 = default and THEME.Blue or THEME.Track
    track.BorderSizePixel = 0
    track.Parent = parent
    corner(track, 11)
    stroke(track, THEME.White, 1, 0.6)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = default and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    knob.BackgroundColor3 = THEME.White
    knob.BorderSizePixel = 0
    knob.Parent = track
    corner(knob, 9)

    local state = default
    local btn = Instance.new("TextButton")
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Parent = track
    btn.MouseButton1Click:Connect(function()
        state = not state
        playClick()
        local goal = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = goal }):Play()
        TweenService:Create(track, TweenInfo.new(0.2), { BackgroundColor3 = state and THEME.Blue or THEME.Track }):Play()
        onChange(state)
    end)
    return track
end

