--====================================================================
--  BASE BEAM  (rainbow glow + scrolling soundwave)
--====================================================================
local beam, playerAttachment, baseAttachment

local function findDeliveryHitbox()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        return nil
    end
    for _, plot in ipairs(plots:GetChildren()) do
        local plotSign = plot:FindFirstChild("PlotSign")
        if plotSign then
            local yourBase = plotSign:FindFirstChild("YourBase")
            if yourBase and yourBase.Enabled then
                return plot:FindFirstChild("DeliveryHitbox")
            end
        end
    end
    return nil
end

local function ensureBeam()
    if not character then
        return
    end
    local root = character:FindFirstChild("HumanoidRootPart")
    local deliveryHitbox = findDeliveryHitbox()
    if not root or not deliveryHitbox then
        return
    end

    if not playerAttachment or playerAttachment.Parent ~= root then
        if playerAttachment then
            playerAttachment:Destroy()
        end
        playerAttachment = Instance.new("Attachment")
        playerAttachment.Name = "PlayerBeamAttachment"
        playerAttachment.Parent = root
    end

    if not baseAttachment or baseAttachment.Parent ~= deliveryHitbox then
        if baseAttachment then
            baseAttachment:Destroy()
        end
        baseAttachment = Instance.new("Attachment")
        baseAttachment.Name = "BaseBeamAttachment"
        baseAttachment.Parent = deliveryHitbox
    end

    if not beam or not beam.Parent then
        beam = Instance.new("Beam")
        beam.Name = "BaseBeam"
        beam.Width0 = 1.5
        beam.Width1 = 1.5
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.FaceCamera = true
        beam.Transparency = NumberSequence.new(0)
        beam.Texture = CONFIG.BeamTexture
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 4
        beam.TextureSpeed = 2  -- positive = waveform scrolls player -> base
        beam.Parent = Workspace
    end

    beam.Attachment0 = playerAttachment
    beam.Attachment1 = baseAttachment
    beam.Enabled = beamEnabled
end

-- rainbow flow
local beamHue = 0
RunService.Heartbeat:Connect(function(dt)
    if not isCurrent() then
        return
    end
    if beam and beam.Parent and beam.Enabled then
        beamHue = (beamHue + dt * 0.25) % 1
        beam.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromHSV(beamHue, 1, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV((beamHue + 0.33) % 1, 1, 1)),
            ColorSequenceKeypoint.new(1,   Color3.fromHSV((beamHue + 0.66) % 1, 1, 1)),
        })
    end
end)

-- keep the beam alive / attached
task.spawn(function()
    while isCurrent() do
        if beamEnabled then
            ensureBeam()
        elseif beam then
            beam.Enabled = false
        end
        task.wait(1)
    end
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    if beamEnabled and isCurrent() then
        ensureBeam()
    end
end)

--====================================================================
--  Q FLING  ->  ORBIT  ->  UNFLING  ->  KICK
--====================================================================
local function getBeamEndPosition()
    if baseAttachment and baseAttachment.Parent then
        return baseAttachment.WorldPosition
    end
    local hitbox = findDeliveryHitbox()
    if hitbox then
        return hitbox.Position
    end
    return nil
end

local function flingToBeamEnd()
    if isFlinging then
        return
    end
    local target = getBeamEndPosition()
    if not target or not rootPart or not rootPart.Parent then
        return
    end
    isFlinging = true

    -- galactic glow on the body during the warp
    local highlight = Instance.new("Highlight")
    highlight.FillColor = THEME.Magenta
    highlight.OutlineColor = THEME.Cyan
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Parent = character

    -- physics fling
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1, 1, 1) * 1e9
    bv.P = 2000
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = rootPart

    task.spawn(function()
        -- PHASE 1: launch toward the beam end at full force (capped at FlingSpeed)
        local t0 = os.clock()
        while isFlinging and rootPart and rootPart.Parent
              and (rootPart.Position - target).Magnitude > 6
              and (os.clock() - t0) < 4 do
            local dir = target - rootPart.Position
            local speed = math.min(dir.Magnitude * 5, CONFIG.FlingSpeed)
            bv.Velocity = dir.Unit * speed
            RunService.Heartbeat:Wait()
        end

        -- PHASE 2: orbit the beam end for OrbitTime seconds
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.MaxForce = Vector3.new(0, 0, 0) -- hand control to CFrame for a clean orbit
        local t1 = os.clock()
        while isFlinging and rootPart and rootPart.Parent
              and (os.clock() - t1) < CONFIG.OrbitTime do
            local a = ((os.clock() - t1) / CONFIG.OrbitTime) * (math.pi * 2 * CONFIG.OrbitSpins)
            local offset = Vector3.new(math.cos(a) * CONFIG.OrbitRadius, 3, math.sin(a) * CONFIG.OrbitRadius)
            rootPart.CFrame = CFrame.lookAt(target + offset, target)
            RunService.Heartbeat:Wait()
        end

        -- PHASE 3: unfling, then kick (delete the Kick line to skip the kick)
        if bv then
            bv:Destroy()
        end
        if highlight then
            highlight:Destroy()
        end
        isFlinging = false
        player:Kick("NEBULA HUB  -  warped into the void. See you starside.")
    end)
end

--====================================================================
--  FOV + TELEPORT WALK loops
