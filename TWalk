-- helpers ------------------------------------------------------------
local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = parent
    return c
end
local function stroke(parent, color, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thick or 1.5
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end
local function gradient(parent, c0, c1, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c0, c1)
    g.Rotation = rot or 90
    g.Parent = parent
    return g
end
local function comma(n)
    local s = tostring(math.floor(n))
    while true do
        local new, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        s = new
        if k == 0 then
            break
        end
    end
    return s
end

-- animation registries
local wobblers = {}      -- { obj, amp, speed, phase }
local rainbowGrads = {}  -- UIGradients to flow
local rainbowText = {}   -- TextLabels whose TextColor cycles

local function addWobble(obj, amp, speed)
    table.insert(wobblers, { obj = obj, amp = amp or 3, speed = speed or 2.2, phase = #wobblers * 0.6 })
end
local function rainbowGradient(obj)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 80, 120)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 90)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(90, 255, 150)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 200, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(210, 120, 255)),
    })
    g.Parent = obj
    table.insert(rainbowGrads, g)
    return g
end

