--====================================================================
--  BASE BEAM (rainbow glow + scrolling soundwave) - visual
--====================================================================
local beam, playerAttachment, baseAttachment

local function findDeliveryHitbox()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        return nil
    end
    for _, plot in ipairs(plots:GetChildren()) do
        local plotSign = plot:FindFirstChild("PlotSign")
        if plotSign then
            local yourBase = plotSign:FindFirstChild("YourBase")
            if yourBase and yourBase.Enabled then
                return plot:FindFirstChild("DeliveryHitbox")
            end
        end
    end
    return nil
end

local function ensureBeam()
    if not character then
        return
    end
    local root = character:FindFirstChild("HumanoidRootPart")
    local deliveryHitbox = findDeliveryHitbox()
    if not root or not deliveryHitbox then
        return
    end
    if not playerAttachment or playerAttachment.Parent ~= root then
        if playerAttachment then
            playerAttachment:Destroy()
        end
        playerAttachment = Instance.new("Attachment")
        playerAttachment.Name = "PlayerBeamAttachment"
        playerAttachment.Parent = root
    end
    if not baseAttachment or baseAttachment.Parent ~= deliveryHitbox then
        if baseAttachment then
            baseAttachment:Destroy()
        end
        baseAttachment = Instance.new("Attachment")
        baseAttachment.Name = "BaseBeamAttachment"
        baseAttachment.Parent = deliveryHitbox
    end
    if not beam or not beam.Parent then
        beam = Instance.new("Beam")
        beam.Name = "BaseBeam"
        beam.Width0 = 1.5
        beam.Width1 = 1.5
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.FaceCamera = true
        beam.Transparency = NumberSequence.new(0)
        beam.Texture = CONFIG.BeamTexture
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 4
        beam.TextureSpeed = 2
        beam.Parent = Workspace
    end
    beam.Attachment0 = playerAttachment
    beam.Attachment1 = baseAttachment
    beam.Enabled = true
end

local beamHue = 0
RunService.Heartbeat:Connect(function(dt)
    if not isCurrent() then
        return
    end
    if beam and beam.Parent and beam.Enabled then
        beamHue = (beamHue + dt * 0.25) % 1
        beam.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromHSV(beamHue, 1, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV((beamHue + 0.33) % 1, 1, 1)),
            ColorSequenceKeypoint.new(1,   Color3.fromHSV((beamHue + 0.66) % 1, 1, 1)),
        })
    end
end)

task.spawn(function()
    while isCurrent() do
        ensureBeam()
        task.wait(1)
    end
end)

--====================================================================
--  BACKWARD TP  (3.00-3.50 studs every 2.0-3.0 s)  +  FOV + TP WALK
--====================================================================
task.spawn(function()
    while isCurrent() do
        if backwardTPEnabled and rootPart and rootPart.Parent and not isFlinging then
            local dist = CONFIG.BackMin + math.random() * (CONFIG.BackMax - CONFIG.BackMin)
            rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, dist) -- +Z = backward
        end
        local waitTime = CONFIG.BackEveryMin + math.random() * (CONFIG.BackEveryMax - CONFIG.BackEveryMin)
        task.wait(waitTime)
    end
end)

RunService.RenderStepped:Connect(function()
    if not isCurrent() then
        return
    end
    local cam = Workspace.CurrentCamera
    if cam then
        cam.FieldOfView = CONFIG.FOV
    end
    if not isFlinging and character and humanoid and rootPart and rootPart.Parent then
        if humanoid.MoveDirection.Magnitude > 0 then
            rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * CONFIG.TeleportWalk)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end
    if input.KeyCode == Enum.KeyCode.Q then
        local moveDir = humanoid and humanoid.MoveDirection or Vector3.new(0, 0, 0)
        flingThrough(moveDir)
    end
end)

--====================================================================
--  DISCORD STEAL REPORTER  (standard webhook; user supplies the url)
--====================================================================
local function reportSteal(itemName, value)
    if not showStealsEnabled then
        return
    end
    if CONFIG.Webhook == "" then
        warn("[NEBULA HUB] No webhook set in CONFIG.Webhook")
        return
    end
    local robloxName = keepRobloxAnon and "Anonymous" or player.Name
    local discordName = keepDiscordAnon and "Anonymous" or CONFIG.DiscordTag
    local payload = {
        username = "Nebula Hub",
        embeds = {{
            title = "Steal Logged",
            color = 11304447,
            fields = {
                { name = "Roblox",  value = robloxName,  inline = true },
                { name = "Discord", value = discordName, inline = true },
                { name = "Item",    value = tostring(itemName or "Unknown"), inline = false },
                { name = "Value",   value = tostring(value or "?"),          inline = true },
                { name = "FF",      value = tostring(ffValue),               inline = true },
            },
        }},
    }
    -- Roblox blocks discord.com via HttpService; this needs a proxy or an
    -- executor http function. Wrapped in pcall so it never breaks the GUI.
    pcall(function()
        HttpService:PostAsync(CONFIG.Webhook, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
    end)
end

