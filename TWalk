    if teleportWalkEnabled and not isFlinging and character and humanoid and rootPart and rootPart.Parent then
        if humanoid.MoveDirection.Magnitude > 0 then
            rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * CONFIG.TeleportDistance)
        end
    end
end)

