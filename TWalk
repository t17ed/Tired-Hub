local function createSlider(parent, titleText, minV, maxV, default, step, onChange)
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.Size = UDim2.new(1, -28, 0, 48)
    box.LayoutOrder = nextOrder()
    box.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.Font = THEME.PIXEL
    lbl.TextSize = 18
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = THEME.Text
    lbl.Parent = box
    rainbowGradient(lbl)
    addWobble(lbl, 1.5, 1.8)

    local bar = Instance.new("Frame")
    bar.BackgroundColor3 = THEME.Track
    bar.BorderSizePixel = 0
    bar.Size = UDim2.new(1, 0, 0, 8)
    bar.Position = UDim2.new(0, 0, 0, 30)
    bar.Parent = box
    corner(bar, 4)

    local fill = Instance.new("Frame")
    fill.BorderSizePixel = 0
    fill.BackgroundColor3 = THEME.White
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.Parent = bar
    corner(fill, 4)
    rainbowGradient(fill)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.BackgroundColor3 = THEME.White
    knob.BorderSizePixel = 0
    knob.Parent = bar
    corner(knob, 9)
    stroke(knob, THEME.Blue, 2, 0)

    local function setFromPercent(p)
        p = math.clamp(p, 0, 1)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        fill.Size = UDim2.new(p, 0, 1, 0)
        local v = minV + (maxV - minV) * p
        if step then
            v = math.floor(v / step + 0.5) * step
        else
            v = math.floor(v + 0.5)
        end
        lbl.Text = titleText .. ": " .. comma(v)
        onChange(v)
    end
    local function updateFromX(x)
        setFromPercent((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1))
    end
    setFromPercent((default - minV) / (maxV - minV))

    local function beginDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = updateFromX
            playClick()
            updateFromX(input.Position.X)
            TweenService:Create(knob, TweenInfo.new(0.12), { Size = UDim2.new(0, 22, 0, 22) }):Play()
        end
    end
    bar.InputBegan:Connect(beginDrag)
    knob.InputBegan:Connect(beginDrag)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(knob, TweenInfo.new(0.12), { Size = UDim2.new(0, 18, 0, 18) }):Play()
        end
    end)
    return box
end

