local settingsOpen = false
local function openSettings(open)
    settingsOpen = open
    if open then
        setHolder.Visible = true
        setPanel.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(setPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Size = UDim2.new(0, 280, 0, 170) }):Play()
    else
        local t = TweenService:Create(setPanel, TweenInfo.new(0.2, Enum.EasingStyle.Quad),
            { Size = UDim2.new(0, 0, 0, 0) })
        t:Play()
        t.Completed:Connect(function()
            setHolder.Visible = false
        end)
    end
end
