--====================================================================
--  FLING + NOCLIP (touch a >0.1 transparency wall, or press Q)
--====================================================================
local function flingThrough(dir)
    if isFlinging or not rootPart or not rootPart.Parent then
        return
    end
    isFlinging = true

    dir = dir or rootPart.CFrame.LookVector
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then
        dir = rootPart.CFrame.LookVector
    end
    dir = dir.Unit

    -- remember + drop collisions so we pass through the wall
    local saved = {}
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            saved[p] = p.CanCollide
        end
    end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1, 1, 1) * 1e9
    bv.P = 2000
    bv.Velocity = dir * CONFIG.FlingSpeed
    bv.Parent = rootPart

    task.spawn(function()
        local t0 = os.clock()
        while isFlinging and rootPart and rootPart.Parent and (os.clock() - t0) < CONFIG.FlingTime do
            for p, _ in pairs(saved) do
                if p and p.Parent then
                    p.CanCollide = false
                end
            end
            bv.Velocity = dir * CONFIG.FlingSpeed
            RunService.Heartbeat:Wait()
        end
        for p, orig in pairs(saved) do
            if p and p.Parent then
                p.CanCollide = orig
            end
        end
        if bv then
            bv:Destroy()
        end
        isFlinging = false
    end)
end

local lastFling = 0
local function onTouched(hit)
    if isFlinging or (os.clock() - lastFling) < 1 then
        return
    end
    if not hit or not hit:IsA("BasePart") then
        return
    end
    if not character or hit:IsDescendantOf(character) then
        return
    end
    if not hit.CanCollide or hit.Transparency <= CONFIG.WallTransparency then
        return
    end
    lastFling = os.clock()
    local moveDir = humanoid and humanoid.MoveDirection or Vector3.new(0, 0, 0)
    flingThrough(moveDir)
end

