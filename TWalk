local vpModel = nil
local function populateViewport()
    if vpModel then
        vpModel:Destroy()
        vpModel = nil
    end
    local char = player.Character
    if not char then
        return
    end
    local ok, clone = pcall(function()
        return char:Clone()
    end)
    if not ok or not clone then
        return
    end
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") then
            d:Destroy()
        end
    end
    if clone:FindFirstChild("HumanoidRootPart") then
        clone.PrimaryPart = clone.HumanoidRootPart
    end
    pcall(function()
        clone:PivotTo(CFrame.new(0, 0, 0))
    end)
    clone.Parent = vpf
    vpModel = clone
end
task.spawn(function()
    task.wait(1)
    populateViewport()
end)
player.CharacterAdded:Connect(function()
    task.wait(1.2)
    populateViewport()
    nameDisplay.Text = player.DisplayName
    nameUser.Text = "@" .. player.Name
end)

--========================  ANIMATION LOOP  ==================--
local animClock = 0
RunService.RenderStepped:Connect(function(dt)
    if not isCurrent() then
        return
    end
    animClock = animClock + dt

    -- neon edges cycle hue
    local hue = (animClock * 0.08) % 1
    local c0 = Color3.fromHSV(hue, 0.7, 1)
    mainStroke.Color = c0
    setStroke.Color = c0
    vpStroke.Color = c0
    mainGlow.ImageColor3 = c0

    -- flow the rainbow gradients
    local off = (animClock * 0.25) % 1
    for _, g in ipairs(rainbowGrads) do
        g.Offset = Vector2.new(off, 0)
    end

    -- wobble text
    for _, w in ipairs(wobblers) do
        if w.obj and w.obj.Parent then
            w.obj.Rotation = math.sin(animClock * w.speed + w.phase) * w.amp
        end
    end

    -- smooth drag follow
    holder.Position = holder.Position:Lerp(dragTarget, 0.2)

    -- orbit the viewport camera around the model
    if vpModel then
        local a = animClock * 0.6
        local center = Vector3.new(0, 2, 0)
        local r = 8
        vpCam.CFrame = CFrame.lookAt(center + Vector3.new(math.sin(a) * r, 1.2, math.cos(a) * r), center)
    end
end)

